# --- AI service layer ---
# Selects the provider used by every module except Chat (which lets a user
# pick one per conversation instead). One of: anthropic, openai, gemini, ollama.
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Ollama: local, no API key. Just needs `ollama serve` running and the
# model below pulled (`ollama pull llama3.1`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1

CORS_ORIGINS=["http://localhost:3000"]
